# whenue-api's GraphQL endpoint. Its WHENUE_CORS_ALLOWED_ORIGINS must include this panel's origin
# (http://localhost:5173 is allowed by default in development).
VITE_GRAPHQL_URL=http://localhost:8080/graphql

# Prefix of the links staff hand to visitors; whenue-app opens whenue://visit/<token>.
VITE_VISIT_LINK_BASE=whenue://visit/
